{
    "$schema":  "./node_modules/@angular/cli/lib/config/schema.json",
    "version":  1,
    "cli":  {
                "packageManager":  "npm"
            },
    "newProjectRoot":  "projects",
    "projects":  {
                     "web-proyectp":  {
                                          "projectType":  "application",
                                          "schematics":  {

                                                         },
                                          "root":  "web-proyectp",
                                          "sourceRoot":  "web-proyectp/src",
                                          "prefix":  "app",
                                          "architect":  {
                                                            "build":  {
                                                                          "builder":  "@angular/build:application",
                                                                          "options":  {
                                                                                          "browser":  "web-proyectp/src/main.ts",
                                                                                          "tsConfig":  "web-proyectp/tsconfig.app.json",
                                                                                          "assets":  [
                                                                                                         {
                                                                                                             "glob":  "**/*",
                                                                                                             "input":  "web-proyectp/public"
                                                                                                         }
                                                                                                     ],
                                                                                          "styles":  [
                                                                                                         "web-proyectp/src/styles.css"
                                                                                                     ]
                                                                                      },
                                                                          "configurations":  {
                                                                                                 "production":  {
                                                                                                                    "budgets":  [
                                                                                                                                    {
                                                                                                                                        "type":  "initial",
                                                                                                                                        "maximumWarning":  "500kB",
                                                                                                                                        "maximumError":  "1MB"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "type":  "anyComponentStyle",
                                                                                                                                        "maximumWarning":  "4kB",
                                                                                                                                        "maximumError":  "8kB"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                    "outputHashing":  "all"
                                                                                                                },
                                                                                                 "development":  {
                                                                                                                     "optimization":  false,
                                                                                                                     "extractLicenses":  false,
                                                                                                                     "sourceMap":  true
                                                                                                                 }
                                                                                             },
                                                                          "defaultConfiguration":  "production"
                                                                      },
                                                            "serve":  {
                                                                          "builder":  "@angular/build:dev-server",
                                                                          "configurations":  {
                                                                                                 "production":  {
                                                                                                                    "buildTarget":  "web-proyectp:build:production"
                                                                                                                },
                                                                                                 "development":  {
                                                                                                                     "buildTarget":  "web-proyectp:build:development"
                                                                                                                 }
                                                                                             },
                                                                          "defaultConfiguration":  "development"
                                                                      },
                                                            "test":  {
                                                                         "builder":  "@angular/build:unit-test",
                                                                         "options":  {
                                                                                         "tsConfig":  "web-proyectp/tsconfig.spec.json"
                                                                                     }
                                                                     }
                                                        }
                                      }
                 }
}
